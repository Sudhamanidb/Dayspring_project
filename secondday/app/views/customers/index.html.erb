<div style="
  min-height:100vh;
  background: linear-gradient(120deg, #f8fafc, #ede9fe);
  padding:40px;
  font-family:'Segoe UI', Inter, Arial;
">

  <div style="
    max-width:1100px;
    margin:auto;
    background:white;
    padding:30px;
    border-radius:16px;
    box-shadow:0 15px 35px rgba(0,0,0,0.1);
  ">

    <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
      <h2 style="color:#1E3A8A;">👥 Customers</h2>

      <%= link_to "➕ Add Customer", new_customer_path, style: "
        background:#1E3A8A;
        color:white;
        padding:10px 18px;
        border-radius:20px;
        text-decoration:none;
      " %>
    </div>

    <table style="width:100%; border-collapse:collapse;">
      <thead style="background:#4338CA; color:white;">
        <tr>
          <th style="padding:14px;">Profile</th>
          <th style="padding:14px;">Name</th>
          <th style="padding:14px;">Email</th>
          <th style="padding:14px;">DOB</th>
          <th style="padding:14px;">Phone</th>
          <th style="padding:14px;">About Me</th>
          <th style="padding:14px;">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% @customers.each do |customer| %>
          <tr style="border-bottom:1px solid #e5e7eb;"
              onmouseover="this.style.background='#f9fafb'"
              onmouseout="this.style.background='white'">

            <!-- Profile -->
            <td style="padding:14px; text-align:center;">
              <% if customer.profile_photo.attached? %>
                <%= image_tag customer.profile_photo, width:45, height:45,
                  style:"border-radius:50%;" %>
              <% else %>
                <span style="color:#9ca3af;">N/A</span>
              <% end %>
            </td>

           
            <td style="padding:14px;"><%= customer.name %></td>
            <td style="padding:14px;"><%= customer.email %></td>
            <td style="padding:14px;"><%= customer.dob %></td>
            <td style="padding:14px;"><%= customer.phone_number %></td>
            <td style="padding:14px;">
              <%= customer.about_me.body.to_s %>
            </td>

            <!-- Actions -->
            <td style="padding:14px;">
              <%= link_to "View", customer, style:"color:#059669; margin-right:10px;" %>
              <%= link_to "Edit", edit_customer_path(customer), style:"color:#F59E0B; margin-right:10px;" %>
              <%= button_to "Delete", customer,
                    method: :delete,
                    data:{confirm:"Are you sure?"},
                    style:"background:none; color:#DC2626; border:none; cursor:pointer;" %>
            </td>

          </tr>
        <% end %>
      </tbody>
    </table>

  </div>
</div>
